# Copy this file to .env for local development.
# Never commit .env or real credentials.

NODE_ENV=development
APP_PORT=3001
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL (Docker Compose)
POSTGRES_DB=worksphere
POSTGRES_USER=worksphere_app
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://worksphere_app:change_this_local_password@localhost:5432/worksphere

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# FastAPI analytics service
ANALYTICS_PORT=8000
ANALYTICS_SERVICE_URL=http://localhost:8000
